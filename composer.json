{
    "name": "pika-02-03/mimimalcms",
    "description": "MimimalCMS: a small PHP MVC framework (router, DI container, views, helpers). The bundled Composer script copies the framework files into your project.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "mimimiku778",
            "email": "0203.sub@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "MimimalCMS\\Composer\\": "src/Composer/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shadow\\": "shadow/",
            "App\\": "app/",
            "Shared\\": "shared/",
            "App\\Views\\": "app/Views/Classes"
        },
        "files": [
            "shared/MimimalCMS_Settings.php",
            "shared/MimimalCMS_Enums.php",
            "shared/MimimalCMS_ExceptionHandler.php",
            "shared/MimimalCMS_HelperFunctions.php",
            "app/Helpers/functions.php"
        ]
    },
    "scripts": {
        "test": "phpunit"
    }
}
